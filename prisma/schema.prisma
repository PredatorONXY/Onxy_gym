// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table (linked to Supabase Auth)
model User {
  id              String   @id
  email           String
  fullName        String   @map("full_name")
  isAdmin         Boolean  @default(false) @map("is_admin")
  isTrainer       Boolean  @default(false) @map("is_trainer")
  specialization  String?
  experienceYears Int?     @map("experience_years")
  bio             String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  clients Client[]

  @@map("users")
}

// Clients table
model Client {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  age       Int?
  gender    String?
  goals     String?
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  progressLogs    ProgressLog[]
  plans           Plan[]
  dietCharts      DietChart[]

  @@map("clients")
}

// Sessions table
model Session {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  sessionDate     DateTime @map("session_date")
  sessionType     String  @map("session_type")
  durationMinutes Int?    @map("duration_minutes")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Progress logs table
model ProgressLog {
  id                  String   @id @default(uuid())
  clientId            String   @map("client_id")
  logDate             DateTime @map("log_date")
  weightKg            Decimal? @map("weight_kg")
  heightCm            Decimal? @map("height_cm")
  bodyFatPercentage   Decimal? @map("body_fat_percentage")
  photoUrl            String?  @map("photo_url")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("progress_logs")
}

// Plans table
model Plan {
  id          String     @id @default(uuid())
  clientId    String     @map("client_id")
  planType    String?    @map("plan_type")
  title       String
  description String?
  active      Boolean    @default(true)
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relations
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@map("plans")
}

// Diet Charts table
model DietChart {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  title       String
  description String?
  active      Boolean   @default(true)
  meals       Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("diet_charts")
}

// Workout Exercises table
model WorkoutExercise {
  id           String  @id @default(uuid())
  planId       String  @map("plan_id")
  exerciseName String  @map("exercise_name")
  sets         Int?
  reps         Int?
  weightKg     Decimal? @map("weight_kg")
  restSeconds  Int?     @map("rest_seconds")
  dayOfWeek    Int?     @map("day_of_week")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("workout_exercises")
}
